# CopSight macOS Desktop Environment Variables
# Copy to .env and configure for your deployment

# Central Backend API Endpoint (e.g. http://localhost:8080/api or https://your-server.domain/api)
VITE_API_URL=http://localhost:8080/api

# Optional Stream Backend URL (if separate from VITE_API_URL)
VITE_STREAM_URL=http://localhost:8000
